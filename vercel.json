{
  "buildCommand": "cd frontend && npm install && npm run build:prod",
  "outputDirectory": "frontend/dist",
  "env": {
    "VITE_APP_BASE_API": "/api/v1"
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://163.177.65.65:8082/api/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

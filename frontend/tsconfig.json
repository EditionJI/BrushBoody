{
  "compilerOptions": {
    "sourceMap": true,
    "module": "ESNext",
    /* Bundler mode */
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["esnext", "dom"],
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "types/*.d.ts", "src/pages/**/*.{ts,tsx,js,jsx}"], //src/pages/**/*.{ts,tsx,js,jsx}
  "exclude": ["dist", "**/*.js", "node_modules"]
}
